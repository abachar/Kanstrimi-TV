DATABASE_URL=postgres://kanstrimi:kanstrimi@localhost:5432/kanstrimi_db
# 32+ chars, used to sign the admin session cookie
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars-min
# where cached TMDB images are stored
DATA_DIR=./data
# bcrypt hash of the admin password (12 chars min). Generate: npm run hash-password -- <password>
ADMIN_PASSWORD_HASH='$2b$10$replace-me'
# login of the admin form, asked with the password (mandatory in production; admin@localhost otherwise)
# ADMIN_EMAIL=
PORT=3000
# Local development only (refused when NODE_ENV=production): the admin password in clear.
# Skips the login page, and reloads the admin pages after each restart of `npm run dev`.
# DEV_PASSWORD=
# The provider account and the TMDB key (podman secrets in production)
XTREAM_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=
TMDB_API_KEY=
