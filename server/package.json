{
  "name": "kanstrimi-server",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run -s css && { tailwindcss -i src/admin/assets/admin.css -o dist/assets/admin.css --watch=always & node --env-file-if-exists=.env --import tsx --watch src/main.ts; }",
    "css": "tailwindcss -i src/admin/assets/admin.css -o dist/assets/admin.css --minify && cp node_modules/basecoat-css/dist/js/all.min.js dist/assets/basecoat.min.js",
    "build": "npm run -s css && esbuild src/main.ts src/db/migrate.ts --bundle --external:sharp --platform=node --format=esm --target=node22 --outdir=dist --tsconfig=tsconfig.json --sourcemap --log-level=warning",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "npm run -s css && node --env-file-if-exists=.env --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "hash-password": "node --import tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.9.1",
    "bcryptjs": "^3.0.3",
    "croner": "^10.0.1",
    "cronstrue": "^3.27.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "lucide-static": "^1.48.0",
    "p-limit": "^7.3.1",
    "postgres": "^3.4.9",
    "saxes": "^6.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22",
    "basecoat-css": "^1.0.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
