# → /etc/containers/systemd/kanstrimi-migrate.container
# Remplacer <owner> et <reseau-postgres>.
[Unit]
Description=Kanstrimi — migrations de schéma
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=kanstrimi-migrate
Image=ghcr.io/<owner>/kanstrimi:latest
AutoUpdate=registry
Network=<reseau-postgres>

# Le même fichier que l'application : src/db/migrate.ts n'a besoin que de
# DATABASE_URL (il n'importe ni @/db ni @/lib/env, donc pas de hash requis).
EnvironmentFile=/etc/kanstrimi/kanstrimi.env

WorkingDir=/app
Exec=node dist/db/migrate.js
Notify=false
LogDriver=journald

[Service]
Type=oneshot
# Pas de RemainAfterExit : l'unité doit redevenir inactive pour être rejouée
# à chaque démarrage de kanstrimi.service (y compris après une auto-update).
TimeoutStartSec=300
