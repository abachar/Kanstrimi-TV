# À ajouter au Caddyfile existant. Remplacer tv.exemple.fr.
tv.exemple.fr {
	encode zstd gzip

	# Le mot de passe circule en clair dans les query strings Xtream et dans les
	# chemins de flux /live/<user>/<pass>/<id>.ts : ne pas l'écrire dans les logs.
	log {
		output file /var/log/caddy/kanstrimi.log
		format filter {
			wrap json
			fields {
				request>uri query {
					replace password REDACTED
				}
			}
		}
	}

	# L'application n'est pas publiée sur l'hôte : on la joint par son nom sur le
	# réseau podman partagé (DNS netavark).
	reverse_proxy kanstrimi:3000 {
		# publicBaseUrl() (src/lib/api/context.ts) et le cookie Secure en dépendent.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}

		# Le XMLTV peut peser plusieurs dizaines de Mo.
		transport http {
			read_timeout 5m
			write_timeout 5m
		}
	}
}
