# → /etc/kanstrimi/kanstrimi.env   (chmod 600, chown root:root)
# Les cinq variables lues par l'application. Pas de guillemets, pas d'espaces
# autour du "=", une par ligne.

# Obligatoire : le serveur s'arrête immédiatement si le hash est absent ou invalide.
# Généré par :  podman run --rm ghcr.io/<owner>/kanstrimi node -e "..."  (voir README)
# C'est le mot de passe de l'admin ET du compte client IPTV, et la clé qui
# déchiffre les identifiants Xtream/TMDB stockés en base.
ADMIN_PASSWORD_HASH=$2b$10$remplacer

# Obligatoires quand NODE_ENV=production (l'application refuse de démarrer sinon).
# L'hôte est le nom du conteneur Postgres sur le réseau podman, jamais localhost.
DATABASE_URL=postgres://kanstrimi:motdepasse@postgres:5432/kanstrimi_db
# openssl rand -base64 48 | tr -d '\n'
SESSION_SECRET=remplacer-par-48-octets-aleatoires

# Facultatifs (valeurs par défaut de l'image).
PORT=3000
DATA_DIR=/var/lib/kanstrimi
